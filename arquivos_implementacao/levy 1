    <!-- JavaScript Integrado -->
    <script>
        // Data Fixa solicitada + Relógio Ativo
        const fixedDateStr = "2026-09-04";
        document.getElementById('current-date').innerText = fixedDateStr;

        function updateTime() {
            const now = new Date();
            const hrs = String(now.getHours()).padStart(2, '0');
            const mins = String(now.getMinutes()).padStart(2, '0');
            const secs = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('current-time').innerText = `${hrs}:${mins}:${secs} UTC`;
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Alternar Abas (Tabs)
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(`tab-${tabId}`).classList.add('active');
            btn.classList.add('active');
        }

        // Simular Exportação de Relatório
        function exportReport() {
            const toast = document.getElementById('toast');
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }

        // Canvas 1: Sismógrafo Realtime Simulation
        const seismogram = document.getElementById('seismographCanvas');
        const ctxSeismo = seismogram.getContext('2d');
        let animationFrameId;
        let xOffset = 0;

        function resizeCanvas() {
            if (seismogram && seismogram.parentElement) {
                seismogram.width = seismogram.parentElement.clientWidth;
                seismogram.height = seismogram.parentElement.clientHeight;
            }
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function drawSeismograph() {
            if (!seismogram.width) return;
            
            const width = seismogram.width;
            const height = seismogram.height;
            const centerY = height / 2;

            ctxSeismo.clearRect(0, 0, width, height);

            // Draw Grid Lines
            ctxSeismo.strokeStyle = 'rgba(255, 255, 255, 0.05)';
            ctxSeismo.lineWidth = 1;
            ctxSeismo.beginPath();
            for(let y = 0; y < height; y += 20) {
                ctxSeismo.moveTo(0, y);
                ctxSeismo.lineTo(width, y);
            }
            ctxSeismo.stroke();

            // Draw Seismic Line
            ctxSeismo.strokeStyle = '#f59e0b'; // Amber Color
            ctxSeismo.lineWidth = 1.8;
            ctxSeismo.shadowBlur = 8;
            ctxSeismo.shadowColor = 'rgba(245, 158, 11, 0.5)';
            ctxSeismo.beginPath();

            xOffset += 0.05;

            for (let x = 0; x < width; x++) {
                // Generate a waveform simulating tremor pulse
                const freq1 = Math.sin((x * 0.03) + xOffset);
                const freq2 = Math.cos((x * 0.08) - xOffset);
                let spike = 0;
                
                // Random seismic peaks simulating 5.2 Mw waveform
                if ((x + Math.floor(xOffset * 10)) % 180 < 40) {
                    spike = (Math.sin(x * 0.3) * 28);
                } else {
                    spike = (Math.random() - 0.5) * 4;
                }

                const y = centerY + (freq1 * 6) + (freq2 * 4) + spike;

                if (x === 0) {
                    ctxSeismo.moveTo(x, y);
                } else {
                    ctxSeismo.lineTo(x, y);
                }
            }
            ctxSeismo.stroke();

            animationFrameId = requestAnimationFrame(drawSeismograph);
        }
        drawSeismograph();

        // Canvas 2: Circular Humidity Gauge (88%)
        const gaugeCanvas = document.getElementById('humidityGaugeCanvas');
        if (gaugeCanvas) {
            const ctxGauge = gaugeCanvas.getContext('2d');
            const cX = gaugeCanvas.width / 2;
            const cY = gaugeCanvas.height / 2;
            const radius = 46;
            const percentage = 0.88; // 88%

            // Background Track
            ctxGauge.beginPath();
            ctxGauge.arc(cX, cY, radius, 0, 2 * Math.PI);
            ctxGauge.strokeStyle = 'rgba(255, 255, 255, 0.08)';
            ctxGauge.lineWidth = 8;
            ctxGauge.stroke();

            // Active Arc
            const startAngle = -0.5 * Math.PI;
            const endAngle = startAngle + (percentage * 2 * Math.PI);

            ctxGauge.beginPath();
            ctxGauge.arc(cX, cY, radius, startAngle, endAngle);
            ctxGauge.strokeStyle = '#ef4444'; // Red Alert
            ctxGauge.lineWidth = 8;
            ctxGauge.lineCap = 'round';
            ctxGauge.shadowBlur = 10;
            ctxGauge.shadowColor = 'rgba(239, 68, 68, 0.6)';
            ctxGauge.stroke();
        }
    </script>
