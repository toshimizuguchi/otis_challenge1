<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SCADA Pro - Centro de Monitoramento Industrial</title>
    <style>
        /* CSS Reset & Variables */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-dark: #0a0e17;
            --bg-card: rgba(18, 26, 43, 0.75);
            --bg-card-hover: rgba(26, 37, 61, 0.85);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-highlight: rgba(6, 182, 212, 0.3);
            
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            
            --cyan-neon: #06b6d4;
            --cyan-glow: rgba(6, 182, 212, 0.4);
            --red-alert: #ef4444;
            --red-glow: rgba(239, 68, 68, 0.4);
            --amber-warn: #f59e0b;
            --amber-glow: rgba(245, 158, 11, 0.3);
            --green-ok: #10b981;
            --green-glow: rgba(16, 185, 129, 0.3);
            --blue-cold: #3b82f6;
            --blue-glow: rgba(59, 130, 246, 0.4);

            --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: var(--font-family);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(6, 182, 212, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(59, 130, 246, 0.05) 0%, transparent 40%);
        }

        /* Header / Control Center */
        .header {
            background: rgba(10, 14, 23, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--cyan-neon), var(--blue-cold));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 12px var(--cyan-glow);
        }

        .logo-icon svg {
            width: 22px;
            height: 22px;
            stroke: #ffffff;
        }

        .header-title h1 {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            background: linear-gradient(to right, #ffffff, var(--text-muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.6rem;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 20px;
            font-size: 0.75rem;
            color: var(--green-ok);
            font-weight: 600;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--green-ok);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--green-ok);
            animation: pulse 1.8s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px var(--green-ok); }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .clock-container {
            text-align: right;
            font-family: monospace;
        }

        .clock-date {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .clock-time {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--cyan-neon);
            text-shadow: 0 0 8px var(--cyan-glow);
        }

        .btn-export {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(59, 130, 246, 0.2));
            border: 1px solid var(--cyan-neon);
            color: var(--text-main);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-export:hover {
            background: var(--cyan-neon);
            color: #000;
            box-shadow: 0 0 15px var(--cyan-glow);
        }

        .btn-export svg {
            width: 16px;
            height: 16px;
        }

        /* Nav Tabs */
        .tabs-nav {
            display: flex;
            gap: 0.5rem;
            padding: 1rem 1.5rem 0 1.5rem;
            border-bottom: 1px solid var(--border-color);
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 0.6rem 1.2rem;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .tab-btn:hover {
            color: var(--text-main);
        }

        .tab-btn.active {
            color: var(--cyan-neon);
            border-bottom-color: var(--cyan-neon);
        }

        .tab-btn svg {
            width: 18px;
            height: 18px;
        }

        /* Container Main */
        .main-content {
            padding: 1.5rem;
            flex: 1;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Grid Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 1.25rem;
        }

        /* Cards Base */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
            animation: cardEntrance 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(15px);
        }

        .card:hover {
            border-color: var(--border-highlight);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .card-title-group {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .card-icon {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.05);
        }

        .card-icon svg {
            width: 18px;
            height: 18px;
        }

        .card-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .card-subtitle {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .badge-alert {
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-amber {
            background: rgba(245, 158, 11, 0.15);
            color: var(--amber-warn);
            border: 1px solid rgba(245, 158, 11, 0.4);
        }

        .badge-blue {
            background: rgba(59, 130, 246, 0.15);
            color: var(--blue-cold);
            border: 1px solid rgba(59, 130, 246, 0.4);
            box-shadow: 0 0 10px var(--blue-glow);
        }

        .badge-red {
            background: rgba(239, 68, 68, 0.15);
            color: var(--red-alert);
            border: 1px solid rgba(239, 68, 68, 0.4);
            animation: blink 1.5s infinite alternate;
        }

        @keyframes blink {
            from { opacity: 0.7; }
            to { opacity: 1; box-shadow: 0 0 10px var(--red-glow); }
        }

        /* Specific Grid Spans */
        .col-span-12 { grid-column: span 12; }
        .col-span-6  { grid-column: span 6; }
        .col-span-4  { grid-column: span 4; }

        @media (max-width: 1024px) {
            .col-span-6, .col-span-4 { grid-column: span 12; }
        }

        /* Card Content Components */
        
        /* 1. Seismic Card */
        .seismic-metric {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .metric-value {
            font-size: 2.2rem;
            font-weight: 800;
            color: #fff;
            line-height: 1;
        }

        .metric-unit {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .canvas-container {
            width: 100%;
            height: 90px;
            margin-top: 1rem;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            position: relative;
            overflow: hidden;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* 2. Cold Warning Card (Sul) */
        .temp-display {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 1rem 0;
            padding: 0.75rem 1rem;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 8px;
            border-left: 4px solid var(--blue-cold);
        }

        .temp-info {
            display: flex;
            align-items: baseline;
            gap: 0.25rem;
        }

        .protection-active-box {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 0.8rem;
            background: rgba(59, 130, 246, 0.1);
            border: 1px dashed var(--blue-cold);
            border-radius: 6px;
            margin-top: 0.75rem;
            font-size: 0.8rem;
            color: #93c5fd;
        }

        /* 3. Humidity/Corrosion Card */
        .gauge-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0.5rem 0;
            position: relative;
        }

        .gauge-canvas-box {
            position: relative;
            width: 120px;
            height: 120px;
        }

        .gauge-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .gauge-percentage {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .corrosion-warning {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.5rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 6px;
            color: #fca5a5;
            font-size: 0.8rem;
            font-weight: 600;
            text-align: center;
        }

        /* 4. Sensor Table Card */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            margin-top: 0.5rem;
        }

        .sensor-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.85rem;
        }

        .sensor-table th {
            padding: 0.75rem 1rem;
            background: rgba(0, 0, 0, 0.3);
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border-color);
        }

        .sensor-table td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            color: var(--text-main);
        }

        .sensor-table tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        .progress-bar-bg {
            width: 100%;
            max-width: 140px;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.6s ease;
        }

        .fill-red { background: linear-gradient(90deg, #f87171, var(--red-alert)); }
        .fill-amber { background: linear-gradient(90deg, #fbbf24, var(--amber-warn)); }
        .fill-green { background: linear-gradient(90deg, #34d399, var(--green-ok)); }

        .action-tag {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .action-urgent {
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .action-medium {
            background: rgba(245, 158, 11, 0.15);
            color: #fde047;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .action-low {
            background: rgba(16, 185, 129, 0.15);
            color: #6ee7b7;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        /* Event Log Table */
        .log-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .log-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 0.85rem;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .log-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .log-time {
            font-family: monospace;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        .log-msg {
            color: var(--text-main);
            font-weight: 500;
        }

        .log-location {
            font-size: 0.75rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
        }

        /* Toast Modal Simulation */
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: #1e293b;
            border: 1px solid var(--cyan-neon);
            color: var(--text-main);
            padding: 1rem 1.25rem;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 15px var(--cyan-glow);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 100;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        /* Keyframes for Staggered Cards */
        @keyframes cardEntrance {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card:nth-child(1) { animation-delay: 0.05s; }
        .card:nth-child(2) { animation-delay: 0.15s; }
        .card:nth-child(3) { animation-delay: 0.25s; }
        .card:nth-child(4) { animation-delay: 0.35s; }

        /* Quick Info Bar */
        .info-pills {
            display: flex;
            gap: 1rem;
            margin-top: 0.5rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .info-pill-item {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        /* Footer */
        .footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(10, 14, 23, 0.5);
        }
    </style>
</head>
<body>

    <!-- Header / Centro de Controle -->
    <header class="header">
        <div class="header-title">
            <div class="logo-icon">
                <svg fill="none; stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
            </div>
            <div>
                <h1>SCADA Industrial Monitor</h1>
                <div class="status-badge">
                    <span class="pulse-dot"></span>
                    <span>SISTEMA OPERACIONAL</span>
                </div>
            </div>
        </div>

        <div class="header-controls">
            <div class="clock-container">
                <div class="clock-date" id="current-date">2026-09-04</div>
                <div class="clock-time" id="current-time">14:32:08 UTC</div>
            </div>
            <button class="btn-export" onclick="exportReport()">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                Exportar Relatório
            </button>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="tabs-nav">
        <button class="tab-btn active" onclick="switchTab('visao-geral', this)">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
            </svg>
            Visão Geral
        </button>
        <button class="tab-btn" onclick="switchTab('log-eventos', this)">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            Log de Eventos
        </button>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">

        <!-- TAB 1: VISÃO GERAL -->
        <div id="tab-visao-geral" class="tab-content active">
            <div class="dashboard-grid">

                <!-- 1. Alerta de Risco Sísmico (México) -->
                <section class="card col-span-4">
                    <div class="card-header">
                        <div class="card-title-group">
                            <div class="card-icon" style="color: var(--amber-warn);">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="card-title">Risco Sísmico</h2>
                                <p class="card-subtitle">Planta Oaxaca - México</p>
                            </div>
                        </div>
                        <span class="badge-alert badge-amber">Monitorando</span>
                    </div>

                    <div class="seismic-metric">
                        <span class="metric-value">5.2</span>
                        <span class="metric-unit">Mw (Magnitude)</span>
                    </div>

                    <div class="info-pills">
                        <div class="info-pill-item">
                            <span>Profundidade: <strong>18 km</strong></span>
                        </div>
                        <div class="info-pill-item">
                            <span>Frequência: <strong>1.4 Hz</strong></span>
                        </div>
                    </div>

                    <div class="canvas-container">
                        <canvas id="seismographCanvas"></canvas>
                    </div>
                </section>

                <!-- 2. Alerta de Padrão Sazonal (Frio Sul do Brasil) -->
                <section class="card col-span-4">
                    <div class="card-header">
                        <div class="card-title-group">
                            <div class="card-icon" style="color: var(--blue-cold);">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m9-9H3m15.364 6.364l-12.728-12.728m12.728 0L5.636 18.364"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="card-title">Padrão Sazonal Frio</h2>
                                <p class="card-subtitle">Unidade Curitiba - Brasil</p>
                            </div>
                        </div>
                        <span class="badge-alert badge-blue">Proteção Ativa</span>
                    </div>

                    <div class="temp-display">
                        <div>
                            <span class="card-subtitle">Temperatura Atual</span>
                            <div class="temp-info">
                                <span class="metric-value" style="color: #93c5fd;">6.4</span>
                                <span class="metric-unit">°C</span>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <span class="card-subtitle">Limiar de Alerta</span>
                            <div style="font-weight: 700; color: var(--text-muted);">&lt; 8.0 °C</div>
                        </div>
                    </div>

                    <div class="protection-active-box">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        <span>Aquecimento de tubulações acionado preventivamente.</span>
                    </div>
                </section>

                <!-- 3. Alerta de Desgaste (Litoral / Umidade) -->
                <section class="card col-span-4">
                    <div class="card-header">
