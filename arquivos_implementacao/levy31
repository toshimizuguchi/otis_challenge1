<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTIS ONE Enterprise - Telemetria & Gestão Operacional</title>
    <style>
        :root {
            --otis-blue: #00205B;
            --tech-sky: #00A3E0;
            --neon-cyan: #00f3ff;
            --emerald: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --bg-dark: #070b14;
            --card-bg: rgba(11, 22, 44, 0.72);
            --card-border: rgba(0, 163, 224, 0.22);
            --card-border-glow: rgba(0, 243, 255, 0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(0, 32, 91, 0.4) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(0, 163, 224, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(7, 11, 20, 0.9) 0%, #070b14 100%);
            background-attachment: fixed;
            padding-bottom: 40px;
        }

        /* Header Layout */
        header {
            background: rgba(0, 32, 91, 0.45);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 12px 24px;
        }

        .header-container {
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .otis-badge {
            background: linear-gradient(135deg, var(--otis-blue), #001030);
            border: 2px solid var(--tech-sky);
            color: #fff;
            font-weight: 900;
            font-size: 22px;
            letter-spacing: 3px;
            padding: 4px 14px;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 163, 224, 0.4);
        }

        .brand-title h1 {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-title p {
            font-size: 11px;
            color: var(--tech-sky);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .header-status {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 13px;
        }

        .status-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 6px 12px;
            border-radius: 20px;
            color: var(--emerald);
            font-weight: 600;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--emerald);
            box-shadow: 0 0 8px var(--emerald);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.2); }
            100% { opacity: 1; transform: scale(1); }
        }

        .time-display {
            color: var(--text-muted);
            font-family: monospace;
            font-size: 13px;
        }

        /* Container Principal */
        .main-container {
            max-width: 1600px;
            margin: 24px auto;
            padding: 0 24px;
        }

        /* Navigation Tabs */
        .tabs-nav {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid var(--card-border);
            margin-bottom: 24px;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .tab-button {
            background: rgba(13, 25, 48, 0.5);
            border: 1px solid var(--card-border);
            border-bottom: none;
            color: var(--text-muted);
            padding: 12px 20px;
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.25s ease;
            white-space: nowrap;
        }

        .tab-button:hover {
            color: #fff;
            background: rgba(0, 163, 224, 0.15);
            border-color: rgba(0, 163, 224, 0.4);
        }

        .tab-button.active {
            background: linear-gradient(180deg, rgba(0, 163, 224, 0.25) 0%, rgba(0, 32, 91, 0.6) 100%);
            color: #ffffff;
            border-color: var(--tech-sky);
            border-bottom: 3px solid var(--neon-cyan);
            box-shadow: 0 -4px 15px rgba(0, 163, 224, 0.2);
        }

        /* Content Sections */
        .tab-content {
            display: none;
            animation: fadeIn 0.35s ease-in-out forwards;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Glassmorphism Card System */
        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .glass-card:hover {
            border-color: var(--card-border-glow);
            box-shadow: 0 8px 32px 0 rgba(0, 163, 224, 0.15);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .card-title {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-title svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: var(--tech-sky);
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* Grid Layouts */
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
        .grid-1-2 { display: grid; grid-template-columns: 1fr 2fr; gap: 20px; }
        .grid-2-1 { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }

        @media (max-width: 1100px) {
            .grid-2, .grid-3, .grid-4, .grid-1-2, .grid-2-1 {
                grid-template-columns: 1fr;
            }
        }

        /* KPI Widget Box */
        .kpi-card {
            background: linear-gradient(135deg, rgba(0, 32, 91, 0.4), rgba(7, 11, 20, 0.6));
            border: 1px solid var(--card-border);
            border-radius: 10px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            position: relative;
        }

        .kpi-label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .kpi-value {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
        }

        .kpi-subtext {
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .text-emerald { color: var(--emerald); }
        .text-warning { color: var(--warning); }
        .text-danger { color: var(--danger); }
        .text-sky { color: var(--tech-sky); }
        .text-cyan { color: var(--neon-cyan); }

        /* Status Indicators & Badges */
        .badge {
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .badge-danger { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4); }
        .badge-warning { background: rgba(245, 158, 11, 0.2); color: #fde047; border: 1px solid rgba(245, 158, 11, 0.4); }
        .badge-emerald { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4); }
        .badge-sky { background: rgba(0, 163, 224, 0.2); color: #7dd3fc; border: 1px solid rgba(0, 163, 224, 0.4); }

        /* Data Tables */
        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            text-align: left;
        }

        th {
            background: rgba(0, 32, 91, 0.6);
            color: var(--tech-sky);
            padding: 12px 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--card-border);
        }

        td {
            padding: 12px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #e2e8f0;
        }

        tr:hover td {
            background: rgba(0, 163, 224, 0.08);
        }

        /* Progress Bar */
        .progress-bar-bg {
            background: rgba(255, 255, 255, 0.1);
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
            width: 100%;
            position: relative;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
            position: relative;
        }

        .progress-bar-fill::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* Form Controls & Inputs */
        .control-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

        .control-label {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
        }

        select, input[type="text"], input[type="number"] {
            background: rgba(7, 11, 20, 0.8);
            border: 1px solid var(--card-border);
            color: #fff;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

        select:focus, input[type="text"]:focus, input[type="number"]:focus {
            border-color: var(--tech-sky);
            box-shadow: 0 0 8px rgba(0, 163, 224, 0.3);
        }

        /* Custom Range Slider */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }

        input[type=range]:focus {
            outline: none;
        }

        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 6px;
            cursor: pointer;
            background: rgba(0, 163, 224, 0.2);
            border-radius: 3px;
            border: 1px solid var(--card-border);
        }

        input[type=range]::-webkit-slider-thumb {
            height: 18px;
            width: 18px;
            border-radius: 50%;
            background: var(--neon-cyan);
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -6px;
            box-shadow: 0 0 10px var(--neon-cyan);
        }

        /* Buttons */
        .btn {
            background: linear-gradient(135deg, var(--otis-blue), #003399);
            border: 1px solid var(--tech-sky);
            color: #fff;
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn:hover {
            background: linear-gradient(135deg, #003399, var(--tech-sky));
            box-shadow: 0 0 15px rgba(0, 163, 224, 0.4);
            transform: translateY(-1px);
        }

        .btn-emerald {
            background: linear-gradient(135deg, #064e3b, #047857);
            border-color: var(--emerald);
        }
        .btn-emerald:hover {
            background: linear-gradient(135deg, #047857, #10b981);
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
        }

        .btn-group {
            display: flex;
            gap: 8px;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 11px;
        }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(10px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-container {
            background: rgba(11, 22, 44, 0.95);
            border: 1px solid var(--tech-sky);
            border-radius: 12px;
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(0, 163, 224, 0.3);
            display: flex;
            flex-direction: column;
        }

        .modal-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-body {
            padding: 20px;
            font-size: 13px;
            line-height: 1.6;
            color: #cbd5e1;
        }

        .modal-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--card-border);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            background: rgba(0, 0, 0, 0.2);
        }

        .contract-box {
            background: rgba(0, 0, 0, 0.4);
            border: 1px dashed var(--tech-sky);
            padding: 16px;
            border-radius: 6px;
            font-family: monospace;
            font-size: 12px;
            white-space: pre-wrap;
            color: #93c5fd;
            margin-top: 12px;
        }

        /* Canvas Chart Box */
        .chart-box {
            position: relative;
            width: 100%;
            height: 240px;
        }

        canvas {
            width: 100% !important;
            height: 100% !important;
        }

        /* SVG Icon Helpers */
        .svg-icon {
            display: inline-block;
            width: 16px;
            height: 16px;
            vertical-align: middle;
            fill: currentColor;
        }
    </style>
</head>
<body>

    <!-- HEADER CORPORATIVO OTIS -->
    <header>
        <div class="header-container">
            <div class="brand-logo">
                <div class="otis-badge">OTIS</div>
                <div class="brand-title">
                    <h1>OTIS ONE™ ENTERPRISE HUB</h1>
                    <p>Sistemas de Telemetria & Gestão Operacional LATAM</p>
                </div>
            </div>

            <div class="header-status">
                <div class="status-pill">
                    <div class="status-dot"></div>
                    <span>REDE DE TELEMETRIA OPERACIONAL</span>
                </div>
                <div class="time-display" id="liveClock">2025-02-23 --:--:--</div>
            </div>
        </div>
    </header>

    <!-- CONTAINER PRINCIPAL COM ABAS -->
    <main class="main-container">
        <!-- BARRA DE NAVEGAÇÃO ENTRE ABAS -->
        <nav class="tabs-nav">
            <button class="tab-button active" onclick="switchTab('tab1')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                1. MONITORAMENTO & ALERTAS REGIONAIS
            </button>
            <button class="tab-button" onclick="switchTab('tab2')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                2. TELEMETRIA ENERGÉTICA & REGEN®
            </button>
            <button class="tab-button" onclick="switchTab('tab3')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                3. GESTÃO PREDITIVA & CROSS-CITY
            </button>
            <button class="tab-button" onclick="switchTab('tab4')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                4. ANÁLISE DE DESGASTE & REVISÃO CONTRATUAL
            </button>
        </nav>

        <!-- ABA 1: MONITORAMENTO & ALERTAS REGIONAIS -->
        <section id="tab1" class="tab-content active">
            <!-- ALERTA SÍSMICO MÉXICO -->
            <div class="glass-card" style="margin-bottom: 20px; border-left: 4px solid var(--danger);">
                <div class="card-header">
                    <div class="card-title text-danger">
                        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        MONITORAMENTO SÍSMICO EM TEMPO REAL — CIDADE DO MÉXICO (CDMX) & OAXACA
                    </div>
                    <span class="badge badge-danger">ALERTA ATIVO - P1</span>
                </div>

                <div class="grid-4" style="margin-bottom: 16px;">
                    <div class="kpi-card">
                        <span class="kpi-label">Evento Recente</span>
                        <span class="kpi-value text-danger">6.4 <small style="font-size: 14px;">Richter</small></span>
                        <span class="kpi-subtext text-muted">Falha de Guerrero / Oaxaca</span>
                    </div>
                    <div class="kpi-card">
                        <span class="kpi-label">Status dos Elevadores CDMX</span>
                        <span class="kpi-value text-warning">42 <small style="font-size: 14px;">/ 180</small></span>
                        <span class="kpi-subtext text-warning">Modo de Segurança Ativado</span>
                    </div>
                    <div class="kpi-card">
                        <span class="kpi-label">Protocolo de Emergência</span>
                        <span class="kpi-value text-emerald">100%</span>
                        <span class="kpi-subtext text-emerald">Nivelamento no Andar Próximo</span>
                    </div>
                    <div class="kpi-card">
                        <span class="kpi-label">Ação Manual</span>
                        <button class="btn btn-sm" style="margin-top: 6px;" onclick="triggerSeismicSimulation()">Simular Teste de Parada</button>
                    </div>
                </div>
            </div>

            <!-- PRIORIDADE DE UPGRADE DE SENSORES SÍSMICOS (TABELA FILTRÁVEL) -->
            <div class="glass-card" style="margin-bottom: 20px;">
                <div class="card-header">
                    <div class="card-title">
                        <svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                        LISTA DE PRIORIDADE: UPGRADE DE SENSORES SÍSMICOS (MÉXICO)
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <select id="seismicFilter" onchange="filterSeismicTable()">
                            <option value="ALL">Todas as Severidades</option>
                            <option value="CRITICAL">Apenas Críticos (P1)</option>
                            <option value="WARNING">Apenas Alertas (P2)</option>
                        </select>
                    </div>
                </div>

                <div class="table-container">
                    <table id="seismicTable">
                        <thead>
                            <tr>
                                <th>ID Equipamento</th>
                                <th>Edifício / Localização</th>
                                <th>Desvio Calibração (m/s²)</th>
                                <th>Horas de Uso</th>
                                <th>Severidade</th>
                                <th>Ação Recomendada</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-severity="CRITICAL">
                                <td><strong>MX-CDMX-102</strong></td>
                                <td>Torre Reforma - Shaft A</td>
                                <td><span class="text-danger">0.84 m/s² (Alto)</span></td>
                                <td>18,420 h</td>
                                <td><span class="badge badge-danger">P1 CRÍTICO</span></td>
                                <td><button class="btn btn-sm" onclick="alert('Ordem de serviço de substituição imediata emitida para MX-CDMX-102.')">Substituir Sensor</button></td>
                            </tr>
                            <tr data-severity="CRITICAL">
                                <td><strong>MX-CDMX-108</strong></td>
                                <td>Torre Reforma - Shaft C</td>
                                <td><span class="text-danger">0.79 m/s² (Alto)</span></td>
                                <td>17,900 h</td>
                                <td><span class="badge badge-danger">P1 CRÍTICO</span></td>
                                <td><button class="btn btn-sm" onclick="alert('Ordem de serviço de substituição imediata emitida para MX-CDMX-108.')">Substituir Sensor</button></td>
                            </tr>
                            <tr data-severity="WARNING">
                                <td><strong>MX-CDMX-204</strong></td>
                                <td>World Trade Center CDMX</td>
                                <td><span class="text-warning">0.42 m/s² (Médio)</span></td>
                                <td>14,100 h</td>
                                <td><span class="badge badge-warning">P2 ALERTA</span></td>
                                <td><button class="btn btn-sm" onclick="alert('Recalibração remota iniciada para MX-CDMX-204.')">Recalibrar Remoto</button></td>
