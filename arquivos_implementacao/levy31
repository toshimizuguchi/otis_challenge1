                <button class="btn" style="background: transparent; border-color: var(--text-muted);" onclick="closeContractModal()">Cancelar</button>
                <button class="btn btn-emerald" onclick="exportContract()">Exportar Minuta em PDF / Impressão</button>
            </div>
        </div>
