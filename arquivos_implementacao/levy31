    <!-- JAVASCRIPT NATIVO -->
    <script>
        // --- LIVE CLOCK ---
        function updateClock() {
            const now = new Date();
            const str = now.getFullYear() + '-' +
                String(now.getMonth() + 1).padStart(2, '0') + '-' +
                String(now.getDate()).padStart(2, '0') + ' ' +
                String(now.getHours()).padStart(2, '0') + ':' +
                String(now.getMinutes()).padStart(2, '0') + ':' +
                String(now.getSeconds()).padStart(2, '0');
            document.getElementById('liveClock').innerText = str + ' UTC-3';
        }
        setInterval(updateClock, 1000);
        updateClock();

        // --- TAB SWITCHING ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');

            if (tabId === 'tab2') {
                renderROIChart();
            } else if (tabId === 'tab3') {
                renderCrossCityChart();
            }
        }

        // --- ABA 1: SISMICO SIMULATION & FILTER ---
        function filterSeismicTable() {
            const val = document.getElementById('seismicFilter').value;
            const rows = document.querySelectorAll('#seismicTable tbody tr');
            rows.forEach(row => {
                const sev = row.getAttribute('data-severity');
                if (val === 'ALL' || val === sev) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function triggerSeismicSimulation() {
            alert('INICIANDO TESTE DE PARADA SÍSMICA EM SIMULAÇÃO:\n\n1. Sinais de acelerômetro simulados (0.65 m/s²).\n2. 42 Elevadores direcionados para o andar mais próximo.\n3. Abertura de portas e desligamento de tração concluído em 4.2s com sucesso.');
        }

        // --- ABA 2: REGEN & FINANCIAL CALCULATOR ---
        let currentCurrency = 'BRL';
        const currencyRates = {
            'BRL': { symbol: 'R$', rate: 1.0, tariffDefault: 0.75 },
            'MXN': { symbol: '$', rate: 3.2, tariffDefault: 2.30 },
            'USD': { symbol: '$', rate: 0.20, tariffDefault: 0.18 }
        };

        function setCurrency(curr) {
            currentCurrency = curr;
            document.querySelectorAll('.btn-currency').forEach(b => b.classList.remove('active'));
            document.getElementById('curr' + curr).classList.add('active');

            const cData = currencyRates[curr];
            document.querySelectorAll('.currency-label').forEach(el => el.innerText = cData.symbol);
            document.getElementById('sliderTariff').value = cData.tariffDefault;
            
            updateROICalculator();
            updateUnitSavingsTable();
        }

        function updateUnitSavingsTable() {
            const cData = currencyRates[currentCurrency];
            document.querySelectorAll('.unit-savings').forEach(td => {
                const baseValBRL = parseFloat(td.getAttribute('data-base'));
                const converted = baseValBRL * cData.rate;
                td.innerText = cData.symbol + ' ' + converted.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            });
        }

        function updateROICalculator() {
            const trips = parseInt(document.getElementById('sliderTrips').value);
            const tariff = parseFloat(document.getElementById('sliderTariff').value);
            document.getElementById('tripsValue').innerText = trips.toLocaleString();
            document.getElementById('tariffValue').innerText = tariff.toFixed(2);

            // Fórmula simplificada de economia por viagem
            const kWhPerTripSavings = 0.015; 
            const dailySavingsPerElevator = trips * kWhPerTripSavings * tariff;
            const elevators = 5; // frota média
            const annualSavings = dailySavingsPerElevator * 365 * elevators;
            const cData = currencyRates[currentCurrency];

            const sav1 = annualSavings;
            const sav5 = annualSavings * 5;
            const sav10 = annualSavings * 10;

            // Custo por Drive ReGen
            const driveCost = 35000 * cData.rate;
            const paybackMonths = ((driveCost * elevators) / (annualSavings / 12)).toFixed(1);

            document.getElementById('paybackMonths').innerText = paybackMonths + ' Meses';
            document.getElementById('sav1Year').innerText = cData.symbol + ' ' + Math.round(sav1).toLocaleString('pt-BR');
            document.getElementById('sav5Year').innerText = cData.symbol + ' ' + Math.round(sav5).toLocaleString('pt-BR');
            document.getElementById('sav10Year').innerText = cData.symbol + ' ' + Math.round(sav10).toLocaleString('pt-BR');

            renderROIChart(sav1, sav5, sav10);
        }

        // --- CANVAS CHART: ROI ---
        function renderROIChart(s1 = 48200, s5 = 241000, s10 = 482000) {
            const canvas = document.getElementById('roiChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Adjust canvas resolution
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            // Draw Background Grid
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
            ctx.lineWidth = 1;
            for (let i = 0; i < h; i += 40) {
                ctx.beginPath();
                ctx.moveTo(0, i);
                ctx.lineTo(w, i);
                ctx.stroke();
            }

            // Draw Line Chart
            const points = [
                { x: 40, y: h - 30 },
                { x: w * 0.33, y: h - 30 - (h * 0.2) },
                { x: w * 0.66, y: h - 30 - (h * 0.5) },
                { x: w - 30, y: h - 30 - (h * 0.8) }
            ];

            // Area Gradient
            const grad = ctx.createLinearGradient(0, 0, 0, h);
            grad.addColorStop(0, 'rgba(0, 243, 255, 0.3)');
            grad.addColorStop(1, 'rgba(0, 32, 91, 0.0)');

            ctx.beginPath();
            ctx.moveTo(points[0].x, points[0].y);
            points.forEach(p => ctx.lineTo(p.x, p.y));
            ctx.lineTo(points[points.length - 1].x, h - 30);
            ctx.lineTo(points[0].x, h - 30);
            ctx.closePath();
            ctx.fillStyle = grad;
            ctx.fill();

            // Line
            ctx.beginPath();
            ctx.moveTo(points[0].x, points[0].y);
            points.forEach(p => ctx.lineTo(p.x, p.y));
            ctx.strokeStyle = '#00f3ff';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Points
            points.forEach((p, idx) => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
                ctx.fillStyle = '#00A3E0';
                ctx.fill();
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 2;
                ctx.stroke();

                // Labels
                ctx.fillStyle = '#94a3b8';
                ctx.font = '10px sans-serif';
                const labelText = idx === 0 ? 'Ano 0' : idx === 1 ? 'Ano 1' : idx === 2 ? 'Ano 5' : 'Ano 10';
                ctx.fillText(labelText, p.x - 12, h - 10);
            });
        }

        // --- ABA 3: CROSS-CITY CANVAS CHART & PROCUREMENT ---
        function renderCrossCityChart() {
            const canvas = document.getElementById('crossCityChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            const data = [
                { city: 'Cidade do México (Sismos/Poeira)', years: 5.2, color: '#ef4444' },
                { city: 'Santos (Maresia/Umidade)', years: 3.8, color: '#f59e0b' },
                { city: 'São Paulo (Tráfego Severo)', years: 6.5, color: '#00A3E0' },
                { city: 'Porto Alegre (Sazonal Padrão)', years: 7.8, color: '#10b981' }
            ];

            const maxYears = 10;
            const barHeight = 28;
            const startY = 20;

            data.forEach((item, index) => {
                const y = startY + (index * 50);
                const barWidth = (item.years / maxYears) * (w - 180);

                // City Name
                ctx.fillStyle = '#e2e8f0';
                ctx.font = '11px sans-serif';
                ctx.fillText(item.city, 10, y + 12);

                // Background Bar
                ctx.fillStyle = 'rgba(255,255,255,0.05)';
                ctx.fillRect(160, y, w - 180, barHeight);

                // Filled Bar
                ctx.fillStyle = item.color;
                ctx.fillRect(160, y, barWidth, barHeight);

                // Value Text
                ctx.fillStyle = '#fff';
                ctx.font = 'bold 11px sans-serif';
                ctx.fillText(item.years + ' Anos', 170 + barWidth, y + 18);
            });
        }

        function calculateProcurement() {
            let total = 0;
            let count = 0;
            document.querySelectorAll('.proc-check:checked').forEach(chk => {
                total += parseFloat(chk.getAttribute('data-cost'));
                count += parseInt(chk.getAttribute('data-qty'));
            });

            const discountPct = count > 20 ? 0.22 : count > 10 ? 0.18 : 0.10;
            const savings = total * discountPct;

            document.getElementById('procDiscountPct').innerText = Math.round(discountPct * 100) + '%';
            document.getElementById('procSavings').innerText = 'R$ ' + savings.toLocaleString('pt-BR');
        }

        function generatePurchaseOrder() {
            alert('ORDEM DE COMPRA CONSOLIDADA GERADA:\n\n- Desconto em Escala Aplicado automaticamente.\n- Requisição enviada para a fábrica Otis Indaiatuba / Fornecedores Internacionais.');
        }

        // --- ABA 4: CONTRACT MODAL & JUSTIFICATION ---
        function openContractModal(unit, location, reason, excess) {
            const modal = document.getElementById('contractModal');
            document.getElementById('modalTitle').innerText = 'ADITIVO CONTRATUAL — REEQUILÍBRIO TÉCNICO (' + unit + ')';
            
            const text = 
`TERMO ADITIVO DE MANUTENÇÃO E TELEMETRIA DE ATIVOS — OTIS ONE™

UNIDADE REGISTRADA: ${unit}
LOCALIZAÇÃO: ${location}
FATOR AMBIENTAL CRÍTICO: ${reason}
DESVIO DE DESGASTE CONTRATUAL AUDITADO: ${excess} ACIMA DO LIMITE NOMINAL

CONSIDERANDO QUE:
1. Os dados de sensores IoT de aceleração, vibração e umidade comprovaram estresse mecânico atípico associado às condições da região.
2. A Cláusula 8.2 do Contrato Principal prevê a revisão do valor de cobertura preventiva quando o uso severo ultrapassar 30% da média das tabelas normativas ISO 18738.

DELIBERAÇÃO:
- Ajuste na taxa mensal de conservação de +15.4% a partir do próximo ciclo.
- Inclusão de inspeção preditiva especial trimestral com ultrassom em cabos e drive sem custo adicional de mão de obra.

JUSTIFICATIVA TÉCNICA GERADA EM: ${new Date().toLocaleDateString('pt-BR')} VIA OTIS ENGINE.`;

            document.getElementById('contractText').innerText = text;
            modal.classList.add('active');
        }

        function closeContractModal() {
            document.getElementById('contractModal').classList.remove('active');
        }

        function exportContract() {
            alert('Minuta de Aditivo exportada com sucesso em formato digital assinado pelo sistema OTIS ONE™.');
            closeContractModal();
        }

        // Init calculations on load
        window.onload = function() {
            updateROICalculator();
            calculateProcurement();
        };
    </script>
</body>
