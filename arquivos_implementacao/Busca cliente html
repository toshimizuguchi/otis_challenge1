<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Análise de Busca de Cliente por Telefone</title>
  <!-- Chart.js para geração dos gráficos -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

  <header>
    <div>
      <h1>ANÁLISE DE BUSCA DE CLIENTE POR TELEFONE</h1>
      <p>Plataforma de Inteligência Preditiva & Análise Multidimensional de Consultas</p>
    </div>

    <!-- Status, Data e Hora -->
    <div>
      <div>SISTEMA OPERACIONAL</div>
      <div id="liveDateTime">--/--/---- - --:--:--</div>
    </div>
  </header>

  <!-- Módulo Operacional (+1 busca por clique) -->
  <section>
    <h2>Módulo de Registro Operacional (+1 Busca por Clique)</h2>
    <div>
      <input type="text" id="telefoneInput" placeholder="Digite o telefone ou cliente (ex: 11999998888)">
      <button onclick="registrarBuscaManualmente()">+1 Registrar Busca</button>

      <div>
        <button onclick="registrarAtalho('(11) 98765-4321 (Empresa Alpha)')">+1 (11) 98765-4321</button>
        <button onclick="registrarAtalho('(21) 97654-3210 (Tech Brasil)')">+1 (21) 97654-3210</button>
        <button onclick="registrarAtalho('(31) 98888-7777 (Distribuidora X)')">+1 (31) 98888-7777</button>
        <button onclick="registrarAtalho('(41) 99999-1111 (Comércio Y)')">+1 (41) 99999-1111</button>
        <button onclick="registrarAtalho('(51) 98123-4567 (Grupo Z)')">+1 (51) 98123-4567</button>
      </div>
    </div>
  </section>

  <!-- Cards de KPI Executivos -->
  <section>
    <div>
      <h3>Telefone Mais Buscado Hoje</h3>
      <div id="kpiTelefoneLider">-</div>
      <div id="kpiTotalLider">0 buscas acumuladas</div>
    </div>

    <div>
      <h3>Volume Total de Buscas</h3>
      <div id="kpiTotalGeral">0</div>
      <div>Base de consultas integrada</div>
    </div>

    <div>
      <h3>Projeção Preditiva Líder</h3>
      <div id="kpiProjecaoLider">-</div>
      <div id="kpiStatusTrend">Calculando tendência...</div>
    </div>

    <div>
      <h3>Taxa de Localização Padrão</h3>
      <div id="kpiTaxaSucesso">99.1%</div>
      <div>Dentro das metas operacionais</div>
    </div>
  </section>

  <!-- Estrutura de Tabela e Gráficos -->
  <main>
    <!-- Tabela de Ranking -->
    <section>
      <h2>Ranking de Telefones / Clientes por Recorrência</h2>
      <table>
        <thead>
          <tr>
            <th>Posição / Telefone (Cliente)</th>
            <th>Buscas Atuais</th>
            <th>Participação (%)</th>
            <th>Projeção Preditiva</th>
            <th>Status de Frequência</th>
          </tr>
        </thead>
        <tbody id="tabelaCorpo"></tbody>
      </table>
    </section>

    <!-- Gráfico 1: Volume Atual vs. Projeção (Barras Duplas) -->
    <section>
      <h2>Volume Atual vs. Projeção Preditiva</h2>
      <div>
        <canvas id="graficoBarras"></canvas>
      </div>
    </section>

    <!-- Gráfico 2: Evolução Temporal do Líder (Linha) -->
    <section>
      <h2>Evolução Temporal do Volume de Buscas</h2>
      <div>
        <canvas id="graficoLinhas"></canvas>
      </div>
    </section>

    <!-- Gráfico 3: Distribuição por DDD / Região (Rosca/Doughnut) -->
    <section>
      <h2>Distribuição de Buscas por DDD / Região</h2>
      <div>
        <canvas id="graficoRosca"></canvas>
      </div>
    </section>
  </main>

  <script>
    // Série temporal de consultas por telefone [Mês 1, Mês 2, Mês 3, Mês Atual]
    const historicoTelefones = {
      "(11) 98765-4321 (Empresa Alpha)": [8, 12, 15, 18],
      "(21) 97654-3210 (Tech Brasil)": [20, 18, 14, 11],
      "(31) 98888-7777 (Distribuidora X)": [10, 16, 25, 38],
      "(41) 99999-1111 (Comércio Y)": [3, 2, 4, 3],
      "(51) 98123-4567 (Grupo Z)": [7, 9, 12, 16]
    };

    // Instâncias dos Gráficos Chart.js
    let chartBarras = null;
    let chartLinhas = null;
    let chartRosca = null;

    // Relógio em tempo real
    function atualizarDataHora() {
      const agora = new Date();
      const dia = String(agora.getDate()).padStart(2, '0');
      const mes = String(agora.getMonth() + 1).padStart(2, '0');
      const ano = agora.getFullYear();
      const horas = String(agora.getHours()).padStart(2, '0');
      const minutos = String(agora.getMinutes()).padStart(2, '0');
      const segundos = String(agora.getSeconds()).padStart(2, '0');

      document.getElementById('liveDateTime').innerText = `${dia}/${mes}/${ano} - ${horas}:${minutos}:${segundos}`;
    }
    setInterval(atualizarDataHora, 1000);
    atualizarDataHora();

    // Regressão Linear Preditiva
    function calcularPredicao(serie) {
      const n = serie.length;
      if (n < 2) return { previsao: serie[0] || 0, inclinacao: 0 };

      const x = Array.from({ length: n }, (_, i) => i + 1);
      const y = serie;

      const sumX = x.reduce((a, b) => a + b, 0);
      const sumY = y.reduce((a, b) => a + b, 0);
      const sumXY = x.reduce((a, b, i) => a + (b * y[i]), 0);
      const sumXX = x.reduce((a, b) => a + (b * b), 0);

      const inclinacao = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
      const intercepto = (sumY - inclinacao * sumX) / n;

      const proximoPeriodo = n + 1;
      const previsao = Math.max(0, Math.round(inclinacao * proximoPeriodo + intercepto));

      return { previsao, inclinacao };
    }

    function processarDashboard() {
      const listaTelefones = Object.keys(historicoTelefones);
      let totalGeral = 0;
      let telefoneLider = null;
      let maxBuscas = -1;

      let telefoneMaiorRisco = null;
      let maiorPrevisaoPreditiva = -1;
      let maiorInclinacao = 0;

      const relatorio = [];

      listaTelefones.forEach(chave => {
        const historico = historicoTelefones[chave];
        const atual = historico[historico.length - 1];
        totalGeral += atual;

        if (atual > maxBuscas) {
          maxBuscas = atual;
          telefoneLider = chave;
        }

        const predicao = calcularPredicao(historico);

        if (predicao.previsao > maiorPrevisaoPreditiva) {
          maiorPrevisaoPreditiva = predicao.previsao;
          telefoneMaiorRisco = chave;
          maiorInclinacao = predicao.inclinacao;
        }

        relatorio.push({
          telefone: chave,
          atual,
          previsao: predicao.previsao,
          inclinacao: predicao.inclinacao,
          historico
        });
      });

      relatorio.sort((a, b) => b.atual - a.atual);

      // KPIs
      document.getElementById('kpiTotalGeral').innerText = totalGeral;
      document.getElementById('kpiTelefoneLider').innerText = telefoneLider || '-';
      document.getElementById('kpiTotalLider').innerText = `${maxBuscas} buscas (${((maxBuscas / totalGeral) * 100).toFixed(1)}%)`;

      document.getElementById('kpiProjecaoLider').innerText = telefoneMaiorRisco || '-';
      document.getElementById('kpiStatusTrend').innerText = `Est. ${maiorPrevisaoPreditiva} buscas (${maiorInclinacao > 1.5 ? 'Alta Frequência' : 'Frequência Estável'})`;

      // Tabela
      const tbody = document.getElementById('tabelaCorpo');
      tbody.innerHTML = '';

      relatorio.forEach((item, index) => {
        const perc = totalGeral > 0 ? ((item.atual / totalGeral) * 100).toFixed(1) : 0;
        
        let statusText = 'Normal';
        if (item.inclinacao > 2.0) {
          statusText = 'Alta Recorrência / Risco';
        } else if (item.inclinacao > 0.8) {
          statusText = 'Atenção / Crescente';
        }

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${index + 1}º - ${item.telefone}</strong></td>
          <td><strong>${item.atual}</strong></td>
          <td>${perc}%</td>
          <td><strong>${item.previsao} buscas</strong></td>
          <td><span>${statusText}</span></td>
        `;
        tbody.appendChild(tr);
      });

      renderizarGraficos(relatorio);
    }

    function renderizarGraficos(dados) {
      const labels = dados.map(d => d.telefone.split(' ')[0]);
      const dadosAtuais = dados.map(d => d.atual);
      const dadosProjeção = dados.map(d => d.previsao);

      // --- GRÁFICO 1: Barras Duplas (Atual vs Projeção) ---
      if (chartBarras) chartBarras.destroy();
      const ctx1 = document.getElementById('graficoBarras').getContext('2d');
      chartBarras = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            { label: 'Buscas Atuais', data: dadosAtuais },
            { label: 'Projeção Preditiva', data: dadosProjeção }
          ]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      // --- GRÁFICO 2: Linhas (Evolução Temporal do Líder) ---
      if (chartLinhas) chartLinhas.destroy();
      const lider = dados[0];
      const serieHistorica = [...lider.historico, lider.previsao];
      const ctx2 = document.getElementById('graficoLinhas').getContext('2d');
      chartLinhas = new Chart(ctx2, {
        type: 'line',
        data: {
          labels: ['Mês 1', 'Mês 2', 'Mês 3', 'Mês Atual', 'Projeção Próx.'],
          datasets: [{
            label: `Evolução: ${lider.telefone.split(' ')[0]}`,
            data: serieHistorica,
            fill: false,
            tension: 0.3
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      // --- GRÁFICO 3: Doughnut (Distribuição por DDD) ---
      if (chartRosca) chartRosca.destroy();
      const ctx3 = document.getElementById('graficoRosca').getContext('2d');
      chartRosca = new Chart(ctx3, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: dadosAtuais
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function registrarBuscaManualmente() {
      const input = document.getElementById('telefoneInput');
      const telefone = input.value.trim();

      if (!telefone) {
        alert('Por favor, informe o telefone ou nome do cliente.');
        return;
      }

      adicionarBusca(telefone);
      input.value = '';
    }

    function registrarAtalho(telefone) {
      adicionarBusca(telefone);
    }

    function adicionarBusca(chave) {
      if (!historicoTelefones[chave]) {
        historicoTelefones[chave] = [0, 0, 0, 0];
      }

      const ultimoIndice = historicoTelefones[chave].length - 1;
      historicoTelefones[chave][ultimoIndice] += 1;

      processarDashboard();
    }

    processarDashboard();
  </script>
</body>
</html>